# Symfony Environment Configuration
# Copy this file to .env and customize for your environment

###> symfony/framework-bundle ###
APP_ENV=dev
APP_SECRET=change_this_secret_in_production_and_staging
###< symfony/framework-bundle ###

###> doctrine/doctrine-bundle ###
DATABASE_URL="mysql://gtd:gtd_dev@db:3306/gtd_app?serverVersion=10.11.0-MariaDB&charset=utf8mb4"
###< doctrine/doctrine-bundle ###

###> lexik/jwt-authentication-bundle ###
JWT_SECRET_KEY=%kernel.project_dir%/config/jwt/private.pem
JWT_PUBLIC_KEY=%kernel.project_dir%/config/jwt/public.pem
JWT_PASSPHRASE=change_this_passphrase
JWT_TTL=900
# JWT token TTL in seconds (900 = 15 minutes)
REFRESH_TOKEN_TTL=604800
# Refresh token TTL in seconds (604800 = 7 days)
###< lexik/jwt-authentication-bundle ###

###> symfony/mailer ###
MAILER_DSN=smtp://mailhog:1025
###< symfony/mailer ###

###> nelmio/cors-bundle ###
CORS_ALLOW_ORIGIN='^https?://(localhost|127\.0\.0\.1)(:[0-9]+)?$'
###< nelmio/cors-bundle ###

###> Apple Sign-In Configuration ###
APPLE_CLIENT_ID=com.example.gtd
APPLE_TEAM_ID=CHANGEME
APPLE_KEY_ID=CHANGEME
APPLE_PRIVATE_KEY_PATH=%kernel.project_dir%/config/apple/AuthKey_CHANGEME.p8
###< Apple Sign-In Configuration ###

###> Application Configuration ###
APP_URL=http://localhost:8000
FRONTEND_URL=http://localhost:3000
###< Application Configuration ###
