# Docker bootstrap environment file
# Actual values are provided via environment variables in Render
# This file provides defaults for Symfony bootstrap only

# Default values - overridden by Render environment variables
# prod for main branch, dev for staging branch
APP_ENV=prod
APP_DEBUG=0

# Placeholder values - MUST be overridden in Render:
APP_SECRET=placeholder-override-in-render
DATABASE_URL=mysql://placeholder:placeholder@localhost/placeholder
JWT_PASSPHRASE=placeholder-override-in-render
JWT_SECRET_KEY=%kernel.project_dir%/config/jwt/private.pem
JWT_PUBLIC_KEY=%kernel.project_dir%/config/jwt/public.pem
JWT_TTL=3600
CORS_ALLOW_ORIGIN=https://placeholder.example.com
RESEND_API_KEY=placeholder-override-in-render
FROM_EMAIL=noreply@placeholder.example.com

# Apple Sign-In (optional - defaults for when not configured)
APPLE_CLIENT_ID=
APPLE_KEY_ID=
APPLE_TEAM_ID=
APPLE_PRIVATE_KEY_PATH=
